# Logging / localization
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Denver

# Postgres (Tiger Cloud)
DB_USERNAME=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quick_chat
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AWS
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=quick-chat-storage

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=
EMBEDDING_REMOTE_URL=http://inference:8001
EMBEDDING_REMOTE_TIMEOUT_S=30
EMBEDDING_VERSION=v1
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.0
RERANK_REMOTE_URL=http://inference:8001
RERANK_REMOTE_TIMEOUT_S=30
CROSS_CASE_LIST_CAP=20
PARTY_FUZZY_MIN_SIMILARITY=0.4
PARTY_CANDIDATE_LIMIT=5

# Vector store (Qdrant)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=case_knowledge_chunks
QDRANT_PREFETCH_LIMIT=50
RETRIEVAL_TOP_K=10

# Chunking
CHUNKING_STRATEGY=structured
CHUNKING_VERSION=v1
CHUNK_TOKEN_SAFETY_MARGIN=0.9
CHUNK_OVERLAP_RATIO=0.15

# LLM (local Ollama; for Claude set LLM_PROVIDER=anthropic, ANTHROPIC_API_KEY,
# LLM_ANSWER_MODEL=claude-sonnet-5-5, LLM_ROUTER_MODEL=claude-haiku-5-5)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_ANSWER_MODEL=qwen3:4b
LLM_ROUTER_MODEL=qwen3:4b
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=

# LangSmith: redacted per-node metadata only; leave disabled unless opted in
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quick-chat

# Chat pipeline
CONTEXT_MAX_TOKENS=12000
CHAT_HISTORY_MAX_TURNS=6
AGENT_MAX_ITERATIONS=4
