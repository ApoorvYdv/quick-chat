# TigerCloud (Postgres) connection string, e.g.:
# postgresql+psycopg://user:password@host:port/dbname?sslmode=require
DATABASE_URL=
DB_USERNAME=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quick_chat
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AWS
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=quick-chat-storage

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=
EMBEDDING_VERSION=v1

# Vector store (Qdrant)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=case_knowledge_chunks

# Chunking
CHUNKING_STRATEGY=structured
CHUNKING_VERSION=v1
CHUNK_TOKEN_SAFETY_MARGIN=0.9
CHUNK_OVERLAP_RATIO=0.15
