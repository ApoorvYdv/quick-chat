# TigerCloud (Postgres) connection string, e.g.:
# postgresql+psycopg://user:password@host:port/dbname?sslmode=require
DATABASE_URL=
DB_USERNAME=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quick_chat

# AWS 
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=quick-chat-storage

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=
